# DVC remote credentials (Cloudflare R2)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Hugging Face token for scripts/download.py (optional for train/eval)
HF_TOKEN=your_hf_token

# MLflow tracking URI (optional, defaults to http://localhost:8080)
MLFLOW_TRACKING_URI=http://localhost:8080
